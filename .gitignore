# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local environment variables
.venv/
venv/
env/
.env
.env.*
!.env.example

# Test, coverage and type-checking output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Packaging output
build/
dist/
*.egg-info/
*.egg

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# SQLite runtime sidecar files (the prototype database itself is retained)
*.db-journal
*.db-shm
*.db-wal
backup-*.db

# IDE and editor settings
.idea/
.vscode/

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# LibreOffice lock files
.~lock.*#
