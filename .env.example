# Address and port exposed by Docker Compose.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8000

# The deployment script generates a random password on first run.
APP_USERNAME=reviewer
APP_PASSWORD=CHANGE_ME_BEFORE_DEPLOYMENT

# Preserve analyst changes across restarts. Keep this at 0 and use
# scripts/manage.sh rebuild-data for an intentional source-data rebuild.
REBUILD_DATABASE=0

# Use the reverse-proxy container/network range when deploying behind one.
FORWARDED_ALLOW_IPS=127.0.0.1
